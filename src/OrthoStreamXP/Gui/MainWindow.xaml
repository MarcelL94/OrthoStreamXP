<Window x:Class="OrthoStreamXP.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="clr-namespace:OrthoStreamXP.Gui"
        x:ClassModifier="internal"
        Title="OrthoStreamXP" Icon="pack://application:,,,/orthostreamxp.ico"
        Width="1080" Height="740" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type gui:HomeViewModel}"><gui:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type gui:SettingsViewModel}"><gui:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type gui:CacheViewModel}"><gui:CacheView /></DataTemplate>
        <DataTemplate DataType="{x:Type gui:LogViewModel}"><gui:LogView /></DataTemplate>
        <DataTemplate DataType="{x:Type gui:AboutViewModel}"><gui:AboutView /></DataTemplate>
        <DataTemplate DataType="{x:Type gui:SetupViewModel}"><gui:SetupView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- The pages, with the sidebar -->
        <Grid Visibility="{Binding InSetup, Converter={StaticResource Visible}, ConverterParameter=Invert}" x:Name="Pages">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="8,12,4,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,4,0,20">
                    <Image Source="pack://application:,,,/orthostreamxp.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="OrthoStreamXP" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Running/stopped, always in sight -->
                <Border DockPanel.Dock="Bottom" Margin="8,0" Padding="12,10" CornerRadius="6"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mount.State}" Value="Running">
                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mount.State}" Value="Starting">
                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mount.State}" Value="Stopping">
                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding SidebarStatus}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Donation link, above the status -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource SidebarLink}" Margin="4,0,4,8"
                        Command="{Binding Donate}" AutomationProperties.Name="Support OrthoStreamXP (opens PayPal)"
                        ToolTip="OrthoStreamXP is free. If you enjoy it, a donation via PayPal helps its development.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEB51;" Width="20" Foreground="#E0245E" />
                        <TextBlock Text="Support the project" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <ListBox ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNav}"
                         ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0"
                         AutomationProperties.Name="Pages" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>

            <!-- Page area: a raised surface, as in Windows 11 Settings -->
            <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
            </Border>
        </Grid>

        <!-- First-run setup, in place of the pages -->
        <ContentControl Content="{Binding Setup}" Focusable="False" />
    </Grid>
</Window>
