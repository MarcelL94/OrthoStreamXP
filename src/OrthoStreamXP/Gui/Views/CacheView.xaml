<UserControl x:Class="OrthoStreamXP.Gui.CacheView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,36" MaxWidth="900">
            <TextBlock Text="Cache" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageIntro}"
                       Text="OrthoStreamXP keeps the textures it builds here, in one folder for each quality, so switching quality never throws textures away. Delete a quality you no longer fly with to free disk space; its textures are downloaded again if you need them." />

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="22" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Root}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Root}" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Open folder" Command="{Binding OpenRoot}" Margin="16,0,0,0" />
                        <Button Content="Change folder" Command="{Binding ChangeFolder}" Margin="8,0,0,0" />
                        <Button Command="{Binding Refresh}" Margin="8,0,0,0" ToolTip="Measure again" AutomationProperties.Name="Measure again">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ProgressBar IsIndeterminate="True" Margin="0,12,0,0" Visibility="{Binding Scanning, Converter={StaticResource Visible}}" />

            <!-- How big it may grow -->
            <Border Style="{StaticResource RowCard}" Margin="0,16,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Cache limit" />
                        <TextBlock Text="{Binding LimitText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="160" VerticalAlignment="Center" ItemsSource="{Binding LimitChoices}" DisplayMemberPath="Label"
                              SelectedItem="{Binding Limit}" AutomationProperties.Name="Cache limit" />
                </Grid>
            </Border>

            <!-- Where it is: every cached area on a map -->
            <TextBlock Text="Areas" Style="{StaticResource SectionTitle}" Visibility="{Binding Map.HasAreas, Converter={StaticResource Visible}}" />
            <Border Style="{StaticResource Card}" Visibility="{Binding Map.HasAreas, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Each square is a 1° area you have flown, pictured from its own textures. Faded ones were not flown for a month: the cache limit removes those first." />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,12,0,0" Focusable="False">
                        <Grid Width="{Binding Map.Width}" Height="{Binding Map.Height}" HorizontalAlignment="Left">
                            <ItemsControl ItemsSource="{Binding Map.Labels}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Map.Tiles}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding Toggle}" Width="{Binding Width}" Height="{Binding Height}" Padding="0" Cursor="Hand"
                                                ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding ToolTip}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Rectangle Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" Opacity="0.35" />
                                                        <Image x:Name="Picture" Source="{Binding Picture}" Stretch="Fill" />
                                                        <Border x:Name="Frame" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsOld}" Value="True">
                                                            <Setter TargetName="Picture" Property="Opacity" Value="0.4" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Frame" Property="BorderThickness" Value="3" />
                                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- City names: over the areas, but clicks go through to them -->
                            <ItemsControl ItemsSource="{Binding Map.CityLabels}" Focusable="False" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas>
                                            <Ellipse Width="6" Height="6" Canvas.Left="-3" Canvas.Top="-3" Fill="White" Stroke="#CC000000" StrokeThickness="1" />
                                            <Border Canvas.Left="5" Canvas.Top="-9" Background="#AA000000" CornerRadius="3" Padding="4,1">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" />
                                            </Border>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Map.SelectionText}" />
                            <TextBlock Text="{Binding InUseNote}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Visibility="{Binding InUseNote, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Select not flown for a month" Command="{Binding Map.SelectOld}" />
                            <Button Content="Clear" Command="{Binding Map.ClearSelection}" Margin="8,0,0,0" />
                            <Button Content="Delete selected" Command="{Binding Map.AskDelete}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <!-- Asked in place, not in a pop-up -->
                    <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="6" Background="{DynamicResource InfoBarWarningSeverityBackgroundBrush}"
                            Visibility="{Binding Map.Confirming, Converter={StaticResource Visible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Map.DeleteQuestion}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                                <Button Content="Delete" Command="{Binding Map.Delete}" Style="{DynamicResource AccentButtonStyle}" />
                                <Button Content="Cancel" Command="{Binding Map.CancelDelete}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="By quality" Style="{StaticResource SectionTitle}" Visibility="{Binding Map.HasAreas, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Visibility="{Binding Error, Converter={StaticResource Visible}}" />
            <TextBlock Style="{StaticResource Secondary}" Margin="2,16,0,0" Text="The cache is empty. It fills up as you fly."
                       Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />

            <ItemsControl ItemsSource="{Binding Items}" Margin="0,16,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="20" Margin="0,0,14,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <Border Style="{StaticResource Badge}" Visibility="{Binding InUse, Converter={StaticResource Visible}}">
                                                <TextBlock Text="In use" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding Open}" ToolTip="Open in Explorer" AutomationProperties.Name="Open in Explorer">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="14" />
                                        </Button>
                                        <Button Command="{Binding AskDelete}" Margin="8,0,0,0" ToolTip="Delete" AutomationProperties.Name="Delete">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <!-- Asked in place, not in a pop-up -->
                                <Border Margin="34,12,0,0" Padding="12,10" CornerRadius="6" Background="{DynamicResource InfoBarWarningSeverityBackgroundBrush}"
                                        Visibility="{Binding Confirming, Converter={StaticResource Visible}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DeleteQuestion}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                                            <Button Content="Delete" Command="{Binding Delete}" Style="{DynamicResource AccentButtonStyle}" />
                                            <Button Content="Cancel" Command="{Binding CancelDelete}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="34,10,0,0" Visibility="{Binding Deleting, Converter={StaticResource Visible}}">
                                    <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center" />
                                    <TextBlock Text="Deleting…" Margin="10,0,0,0" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
