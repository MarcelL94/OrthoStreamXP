<UserControl x:Class="OrthoStreamXP.Gui.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal">
    <Grid Margin="36,28,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Log" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Secondary}" Text="The main steps and any problems. The full, detailed log is in the log folder." />
        </StackPanel>

        <!-- Search and tools -->
        <WrapPanel Grid.Row="1" Margin="0,12,0,4">
            <Grid Width="300" Margin="0,0,16,8">
                <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="34,6,10,6"
                         AutomationProperties.Name="Search the log" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Search the log" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
            </Grid>
            <Button Content="Open log folder" Command="{Binding OpenFolder}" VerticalAlignment="Center" Margin="0,0,0,8"
                    ToolTip="The full, detailed log is there" />
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <ListBox x:Name="Lines" ItemsSource="{Binding View}" Background="Transparent" BorderThickness="0"
                         FontFamily="{StaticResource MonoFont}" FontSize="12" SelectionMode="Extended"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Log lines">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,1" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Time}" Width="64" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="Level" Style="{StaticResource Icon}" Text="&#xE73E;" Width="28" FontSize="13" HorizontalAlignment="Left" TextAlignment="Left"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="{Binding Text}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="WARNING">
                                    <Setter TargetName="Level" Property="Text" Value="&#xE7BA;" />
                                    <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                    <Setter TargetName="Level" Property="Text" Value="&#xEA39;" />
                                    <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="Nothing yet. The main steps appear here once you start OrthoStreamXP on the Home page."
                           Visibility="{Binding Lines.Count, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
