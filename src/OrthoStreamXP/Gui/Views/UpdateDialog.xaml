<Window x:Class="OrthoStreamXP.Gui.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Update OrthoStreamXP"
        Width="600" Height="560" MinWidth="440" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="Intro" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14,20,16" Focusable="False">
                <StackPanel>
                    <StackPanel x:Name="Notes" />
                    <TextBlock x:Name="NoNotes" Style="{StaticResource Secondary}" Visibility="Collapsed"
                               Text="This version came without release notes. They are on its GitHub page." />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2" x:Name="ReleasePageLink" Content="Release notes on GitHub" Style="{StaticResource LinkButton}"
                HorizontalAlignment="Left" Margin="2,12,0,0" Click="OpenReleasePage" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Update and restart" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" MinWidth="148" Click="Confirm" />
            <Button Content="Not now" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
